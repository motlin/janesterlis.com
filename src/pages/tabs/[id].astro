---
import type {GetStaticPaths} from "astro";
import {getCollection, render} from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {SHOW_DRAFTS} from "../../lib/drafts";
import {formatTuning, publishedTabs} from "../../lib/tabs";

export const getStaticPaths = (async () =>
	publishedTabs(await getCollection("tabs"), SHOW_DRAFTS).map((tab) => ({
		params: {id: tab.id},
		props: {tab},
	}))) satisfies GetStaticPaths;

const {tab} = Astro.props;
const {Content} = await render(tab);
const byline = typeof tab.data.artist === "string" ? ` by ${tab.data.artist}` : "";
---

<BaseLayout title={tab.data.title} description={`Guitar tab: ${tab.data.title}${byline}.`}>
	<p class="eyebrow"><a href="/tabs/">Tabs</a>{tab.data.draft && <> · <span class="badge">Draft</span></>}</p>
	<h1>{tab.data.title}</h1>
	<ul class="tab-meta">
		{typeof tab.data.artist === "string" && <li><strong>Artist:</strong> {tab.data.artist}</li>}
		<li><strong>Tuning:</strong> {formatTuning(tab.data.tuning)}</li>
		{typeof tab.data.key === "string" && <li><strong>Key:</strong> {tab.data.key}</li>}
		{typeof tab.data.difficulty === "string" && <li><strong>Level:</strong> {tab.data.difficulty}</li>}
	</ul>
	{
		typeof tab.data.recording === "string" && (
			<div class="recording">
				<h2>Listen along</h2>
				<audio controls preload="none" src={tab.data.recording} />
			</div>
		)
	}
	<div class="prose tab-body">
		<Content />
	</div>
</BaseLayout>
