---
import {getCollection} from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const links = await getCollection("links");
---

<BaseLayout title="Links" description="Useful links for vintage guitar collectors.">
	<p class="eyebrow">For collectors</p>
	<h1>Links</h1>
	<p class="lede">Here I would like to post some of the most informative and valuable links for guitar collectors:</p>
	<ul class="link-list">
		{
			links.map((link) => (
				<li>
					<a href={link.data.url} rel="noopener">{link.data.title}</a>
					<p>{link.data.description}</p>
				</li>
			))
		}
	</ul>
</BaseLayout>
