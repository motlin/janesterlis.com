---
import "../styles/global.css";
import LookPicker from "../components/LookPicker.astro";
import {DEFAULT_LOOK, LOOK_STORAGE_KEY, LOOKS, resolveLook} from "../lib/looks";
import {NAV_ITEMS, isCurrent} from "../lib/nav";

interface Props {
	title: string;
	description: string;
}

const {title, description} = Astro.props;
const pageTitle = Astro.url.pathname === "/" ? `Jan Esterlis · ${title}` : `${title} · Jan Esterlis`;
const lookIds = JSON.stringify(LOOKS.map((look) => look.id));
const applyLook = `(() => {
	let stored = null;
	try { stored = localStorage.getItem(${JSON.stringify(LOOK_STORAGE_KEY)}); } catch {}
	const query = new URLSearchParams(location.search).get("look");
	document.documentElement.dataset.look = (${resolveLook.toString()})(${lookIds}, ${JSON.stringify(DEFAULT_LOOK)}, query, stored);
})();`;
---

<!doctype html>
<html lang="en" data-look={DEFAULT_LOOK}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<script is:inline set:html={applyLook} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono&family=Oswald:wght@500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="wrap">
				<a class="brand" href="/">Jan <span>Esterlis</span></a>
				<button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
				<nav class="site-nav" id="site-nav" aria-label="Main">
					<ul class="nav-list">
						{
							NAV_ITEMS.map((item) => (
								<li>
									<a href={item.href} aria-current={isCurrent(Astro.url.pathname, item.href) ? "page" : undefined}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>
		<main id="main">
			<div class="wrap">
				<slot />
			</div>
		</main>
		<footer class="site-footer">
			<div class="wrap">
				<p>Vintage guitars and good music.</p>
				<p>Say hello: <a href="mailto:jan@janesterlis.com">jan@janesterlis.com</a></p>
			</div>
		</footer>
		<LookPicker />
		<script>
			const button = document.querySelector<HTMLButtonElement>(".menu-button");
			const nav = document.querySelector<HTMLElement>("#site-nav");
			button?.addEventListener("click", () => {
				const open = button.getAttribute("aria-expanded") !== "true";
				button.setAttribute("aria-expanded", String(open));
				nav?.classList.toggle("open", open);
			});
		</script>
	</body>
</html>
