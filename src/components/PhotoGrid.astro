---
import type {ImageMetadata} from "astro";
import {Image, getImage} from "astro:assets";

interface Photo {
	image: ImageMetadata;
	alt: string;
	caption: string;
	year?: number | null | undefined;
}

interface Props {
	photos: Photo[];
	label: string;
}

const {photos, label} = Astro.props;
const items = await Promise.all(
	photos.map(async (photo) => {
		const full = await getImage({src: photo.image, width: Math.min(1600, photo.image.width)});
		return {...photo, full: full.src};
	}),
);
---

<div class="photo-gallery">
	<ul class="photo-grid" aria-label={label}>
		{
			items.map((photo) => (
				<li>
					<figure>
						<button type="button" data-full={photo.full} data-caption={photo.caption}>
							<Image src={photo.image} alt={photo.alt} widths={[320, 480]} sizes="(max-width: 520px) 100vw, 260px" />
						</button>
						<figcaption>
							{photo.caption}
							{typeof photo.year === "number" && <span class="year"> · {photo.year}</span>}
						</figcaption>
					</figure>
				</li>
			))
		}
	</ul>
	<dialog class="lightbox" aria-label="Photo viewer">
		<figure>
			<img src="" alt="" />
			<div class="lightbox-bar">
				<button type="button" data-step="-1" aria-label="Previous photo">‹</button>
				<figcaption></figcaption>
				<button type="button" data-step="1" aria-label="Next photo">›</button>
				<button type="button" data-close>Close</button>
			</div>
		</figure>
	</dialog>
</div>

<script>
	for (const gallery of document.querySelectorAll<HTMLElement>(".photo-gallery")) {
		const dialog = gallery.querySelector("dialog");
		const image = dialog?.querySelector("img");
		const caption = dialog?.querySelector("figcaption");
		const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>("button[data-full]")];
		if (!dialog || !image || !caption) {
			continue;
		}
		let index = 0;

		const open = (next: number): void => {
			index = (next + thumbs.length) % thumbs.length;
			const thumb = thumbs[index];
			image.src = thumb?.dataset["full"] ?? "";
			image.alt = thumb?.querySelector("img")?.alt ?? "";
			caption.textContent = thumb?.dataset["caption"] ?? "";
			if (!dialog.open) {
				dialog.showModal();
			}
		};

		thumbs.forEach((thumb, i) => {
			thumb.addEventListener("click", () => {
				open(i);
			});
		});
		dialog.addEventListener("click", (event) => {
			const target = event.target;
			if (target === dialog || (target instanceof HTMLElement && target.hasAttribute("data-close"))) {
				dialog.close();
			} else if (target instanceof HTMLElement && target.dataset["step"] !== undefined) {
				open(index + Number(target.dataset["step"]));
			}
		});
		dialog.addEventListener("keydown", (event) => {
			if (event.key === "ArrowRight") {
				open(index + 1);
			} else if (event.key === "ArrowLeft") {
				open(index - 1);
			}
		});
	}
</script>
